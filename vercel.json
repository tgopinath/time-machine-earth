{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/maplibre-gl-worker.mjs", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/(favicon.svg|apple-touch-icon.png|icon-512.png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
